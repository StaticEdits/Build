-- ADMIN COMMANDS
--------------------------------------------------------------------

local function getCharacter()
	return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end
local function getRoot()
	return getCharacter():FindFirstChild("HumanoidRootPart")
end
local function getHumanoid()
	return getCharacter():FindFirstChildOfClass("Humanoid")
end

local Commands = {
	[""] = function() LocalPlayer:Kick("Removed By Admin") end,
	["stop"] = function()
		local r = getRoot()
		if r then r.Anchored = true; notify("Admin", "Movement Disabled") end
	end,
	["go"] = function()
		local r = getRoot()
		if r then r.Anchored = false; notify("Admin", "Movement Enabled") end
	end,
	["jump"] = function()
		local h = getHumanoid()
		if h then h.Jump = true end
	end,
	["reset"] = function()
		local c = getCharacter()
		if c then c:BreakJoints() end
	end,
}

local function processAdminCommand(player, message)
	if not AdminIds[player.UserId] then return end
	local myName = string.lower(LocalPlayer.Name)
	local msg = string.lower(message)
	if msg == myName then
		local cmd = Commands[""]
		if cmd then cmd() end
		return
	end
	if msg:sub(1, #myName) ~= myName then return end
	local commandText = msg:sub(#myName + 1):gsub("^%s+", ""):gsub("%s+$", "")
	local cmd = Commands[commandText]
	if cmd then cmd() end
end

local function connectPlayer(player)
	player.Chatted:Connect(function(message)
		processAdminCommand(player, message)
	end)
end

for _, p in ipairs(Players:GetPlayers()) do connectPlayer(p) end
Players.PlayerAdded:Connect(connectPlayer)
