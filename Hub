local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer
local UserId = tostring(LocalPlayer.UserId)

if _G.__PRINTER_ALREADY_RAN then
	warn("Script already ran.")
	return
end
_G.__PRINTER_ALREADY_RAN = true

local WhitelistedWebhook = "https://discord.com/api/webhooks/1508071681195900968/QRXITs731cxoLwfwMRfnAlHOn_m2iz-lfu7kuZ4qqWWx_XANxZ_Od1oDfdi8pFSa4lyh"
local NotWhitelistedWebhook = "https://discord.com/api/webhooks/1495523748550414387/Ux3E3HJIdopR_1GuwCrJcAHSUH3L8vC54fw3Bl1-Zu6YuMm7zOXa8g6tt5q7kBCpmkA"
local URL = "https://raw.githubusercontent.com/StaticEdits/Build/main/Whitelist"

local requestFunc = (syn and syn.request) or http_request or request

if not requestFunc then
	warn("No request function found.")
	return
end

local function notify(title, text)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title,
			Text = text,
			Duration = 8
		})
	end)
end

local function sendWebhook(webhook, message)
	pcall(function()
		requestFunc({
			Url = webhook,
			Method = "POST",
			Headers = { ["Content-Type"] = "application/json" },
			Body = HttpService:JSONEncode({ content = message })
		})
	end)
end

local success, response = pcall(function()
	return requestFunc({ Url = URL, Method = "GET" })
end)

if not success or not response or not response.Body then
	notify("Whitelist", "Failed to load whitelist.")
	return
end

local isAdmin = false
local isWhitelisted = false
local AdminIds = {}

for line in string.gmatch(response.Body, "[^,\r\n]+") do
	line = line:gsub("^%s+", ""):gsub("%s+$", "")
	if line ~= "" then
		if line:sub(1, 1) == "*" then
			local adminId = tonumber(line:sub(2))
			if adminId then
				AdminIds[adminId] = true
				if tostring(adminId) == UserId then
					isAdmin = true
					isWhitelisted = true
				end
			end
		else
			if line == UserId then
				isWhitelisted = true
			end
		end
	end
end

if isAdmin then
	notify("Whitelist", "Admin Access Granted")
elseif isWhitelisted then
	notify("Whitelist", "Whitelist Successful")
	sendWebhook(WhitelistedWebhook, LocalPlayer.DisplayName .. " is Online")
else
	notify("Whitelist", "UNAUTHORIZED ACCESS")
	sendWebhook(NotWhitelistedWebhook, LocalPlayer.Name .. " (" .. LocalPlayer.UserId .. ") (UNAUTHORIZED ACCESS)")
	task.wait(5)
	LocalPlayer:Kick("Nice Try Skiddie")
	return
end

