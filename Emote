    triggerButton.BackgroundColor3 = Color3.fromRGB(120, 60, 255)
end)
triggerButton.MouseLeave:Connect(function()
    triggerButton.BackgroundColor3 = Color3.fromRGB(90, 40, 200)
end)

triggerButton.MouseButton1Click:Connect(function()
    local playerName = playerTextBox.Text
    local abilityName = abilityTextBox.Text

    if playerName ~= "" and abilityName ~= "" then
        local playerObject = game.Workspace:FindFirstChild(playerName)
        if playerObject then
            local ReplicatedStorage = game:GetService("ReplicatedStorage")
            local EmotesModule = ReplicatedStorage.Modules.Characters.Emotes.Relays
            EmotesModule.PlayEmote:InvokeServer(abilityName, "Multiplayer")
            EmotesModule.ForceEmote:InvokeServer(playerObject)
            print("Emote triggered for " .. playerName .. " with ability " .. abilityName)
        else
            warn("Player not found: " .. playerName)
        end
    else
        warn("Both fields must be filled!")
    end
end)
