local heightBox = settingRow("Height Step",  "st", cfg.heightStep, 102)
local rotBox    = settingRow("Rotate Angle", "°",  cfg.rotateAngle,154)

local applyBtn = btn(sPanel,"Apply",14,208,100,28,C.accent);applyBtn.ZIndex=21
local applyMsg = lbl(sPanel,"",122,208,240,28,11,C.muted);applyMsg.ZIndex=21

applyBtn.MouseButton1Click:Connect(function()
