--------------------------------------------------
-- PRINT (fires remotes one per step with ETA)
--------------------------------------------------
local function runPrint(origin)
	-- Ghost gone immediately
	clearGhost()
	if printBar  then printBar.Visible  = true  end
	if cancelBtn then cancelBtn.Visible = false end
	if placeBtn  then
		placeBtn.Text             = "Printing…"
		placeBtn.BackgroundColor3 = Color3.fromRGB(40,40,50)
		placeBtn.TextColor3       = Color3.fromRGB(150,150,165)
	end

	local grassCF  = getGrassCF(currentPlot)
	local rotCF    = CFrame.Angles(0, math.rad(yRot), 0)
	local total    = #currentBlocks
	local placed   = 0

	-- Estimate: sample 3 calls to get avg ms per part
	local startTime = tick()

	for _, b in ipairs(currentBlocks) do
		local worldCF   = CFrame.new(origin) * (rotCF * b.normCF)
		local newRelCF  = grassCF:ToObjectSpace(worldCF)
		local finalRelCF = newRelCF * CFrame.new(0, -b.size.Y * 0.5, 0)

		pcall(function()
			PlaceFurnitureRemote:InvokeServer(unpack({{
				PurchaseForPlace = true,
				Id               = b.id,
				House            = currentPlot,
				RelativeCFrame   = finalRelCF,
				Color            = b.color,
				Size             = { X=b.size.X*10, Y=b.size.Y*10, Z=b.size.Z*10, P=10 },
				CustomColors     = {b.hex},
				PlacingFromUser  = LocalPlayer,
			}}))
		end)

		placed += 1

		-- Update ETA label
		local elapsed = tick() - startTime
		local avgPer  = elapsed / placed
		local remaining = total - placed
		local eta = math.ceil(avgPer * remaining)

		local etaText = placed == total
			and "Done!"
			or  (eta < 60 and eta.."s left" or math.ceil(eta/60).."m left")

		if printLbl then
			printLbl.Text = "Printing "..placed.."/"..total.."  —  "..etaText
		end

		task.wait()   -- yield per part so Roblox doesn't throttle
	end

	print("[OBP] Printed "..placed.." parts")

	task.wait(1.5)

	-- Reset to idle
	state = STATE.IDLE
	heightOff = 0; yRot = 0
	currentBlocks = {}; currentPlot = nil

	if printBar  then printBar.Visible  = false end
	if hotkeyBar then hotkeyBar.Visible = false end
	if rotLbl    then rotLbl.Text = ""          end
	if placeBtn  then
		placeBtn.Text             = "▶  Begin Placement"
		placeBtn.BackgroundColor3 = Color3.fromRGB(50,90,50)
		placeBtn.TextColor3       = Color3.fromRGB(150,150,165)
	end
	setStatus("Ready — load a blueprint to begin")
end

--------------------------------------------------
-- STOP (cancel at any point)
--------------------------------------------------
local loopConn, inputConn

local function stopAll()
	state = STATE.IDLE
	clearGhost()
	heightOff = 0; yRot = 0
	currentBlocks = {}; currentPlot = nil
	if loopConn  then loopConn:Disconnect();  loopConn  = nil end
	if inputConn then inputConn:Disconnect(); inputConn = nil end
	if printBar  then printBar.Visible  = false end
	if cancelBtn then cancelBtn.Visible = false end
	if hotkeyBar then hotkeyBar.Visible = false end
	if rotLbl    then rotLbl.Text = "" end
	if placeBtn  then
		placeBtn.Text             = "▶  Begin Placement"
		placeBtn.BackgroundColor3 = Color3.fromRGB(50,90,50)
		placeBtn.TextColor3       = Color3.fromRGB(150,150,165)
	end
	setStatus("Ready — load a blueprint to begin")
end

--------------------------------------------------
-- RENDER LOOP — only moves ghost in MOVING state
--------------------------------------------------
local smoothPos
local smoothSpeed = 25

local function startLoop()
	if loopConn then
		loopConn:Disconnect()
	end

	smoothPos = getMouseGroundPos()

	loopConn = RunService.RenderStepped:Connect(function(dt)

		if state == STATE.MOVING then
			local targetPos = getMouseGroundPos()

			local alpha = 1 - math.exp(-smoothSpeed * dt)

			smoothPos = Vector3.new(
				smoothPos.X + (targetPos.X - smoothPos.X) * alpha,
				targetPos.Y,
				smoothPos.Z + (targetPos.Z - smoothPos.Z) * alpha
			)

			applyOriginToGhost(smoothPos)
		end

		if rotLbl then
			rotLbl.Text =
				(state ~= STATE.IDLE and state ~= STATE.PRINTING)
				and (yRot .. "°")
				or ""
		end
	end)
end

--------------------------------------------------
-- INPUT
--------------------------------------------------
local function startInput()
	if inputConn then inputConn:Disconnect() end
	inputConn = UserInputService.InputBegan:Connect(function(inp, gpe)
		if gpe then return end

		if state == STATE.MOVING then
			local k = inp.KeyCode
			if k == Enum.KeyCode.Q then
				heightOff = heightOff - cfg.heightStep
			elseif k == Enum.KeyCode.E then
				heightOff = heightOff + cfg.heightStep
			elseif k == Enum.KeyCode.R then
				yRot = (yRot + cfg.rotateAngle) % 360
				rebuildOffsets()
			elseif inp.UserInputType == Enum.UserInputType.MouseButton1 then
				-- First click: anchor in place
				frozenOrigin = getMouseGroundPos()
				applyOriginToGhost(frozenOrigin)
				state = STATE.ANCHORED
				setStatus("Anchored — click again to print, Cancel to reposition",
					Color3.fromRGB(220,180,60))
				if placeBtn then
					placeBtn.Text             = "🖨  Print Here"
					placeBtn.BackgroundColor3 = Color3.fromRGB(60,110,180)
					placeBtn.TextColor3       = Color3.new(1,1,1)
				end
			end

		elseif state == STATE.ANCHORED then
			if inp.UserInputType == Enum.UserInputType.MouseButton1 then
				-- Second click: start printing
				state = STATE.PRINTING
				task.spawn(runPrint, frozenOrigin)
			elseif inp.KeyCode == Enum.KeyCode.X then
				-- X cancels anchor back to moving
				state = STATE.MOVING
				setStatus("Moving — click to anchor",
					Color3.fromRGB(80,200,110))
				if placeBtn then
					placeBtn.Text             = "🔒  Anchor"
					placeBtn.BackgroundColor3 = Color3.fromRGB(50,90,50)
					placeBtn.TextColor3       = Color3.new(1,1,1)
				end
			end
		end
	end)
end

--------------------------------------------------
-- BEGIN PLACEMENT
--------------------------------------------------
local function beginPlacement(blocks, plot)
	if #blocks == 0 or not plot then return end
	currentBlocks = blocks
	currentPlot   = plot
	heightOff     = 0; yRot = 0
	state         = STATE.MOVING

	lastGroundY = getGroundY(
	Mouse.Hit.Position.X,
	Mouse.Hit.Position.Z
)
	buildGhost(blocks)
	rebuildOffsets()
	startLoop()
	startInput()

	setStatus("Moving — click to anchor", Color3.fromRGB(80,200,110))
	if placeBtn then
		placeBtn.Text             = "🔒  Anchor"
		placeBtn.BackgroundColor3 = Color3.fromRGB(50,90,50)
		placeBtn.TextColor3       = Color3.new(1,1,1)
	end
	if cancelBtn then cancelBtn.Visible = true  end
	if hotkeyBar then hotkeyBar.Visible = true  end
end

