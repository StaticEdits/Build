closeMainBtn.MouseButton1Click:Connect(function()
	stopAll(); gui:Destroy(); GhostFolder:Destroy()
end)

cancelBtn.MouseButton1Click:Connect(function()
	if state == STATE.ANCHORED then
		-- unanchor back to moving
		state = STATE.MOVING
		setStatus("Moving — click to anchor", Color3.fromRGB(80,200,110))
		if placeBtn then
			placeBtn.Text="🔒  Anchor"
			placeBtn.BackgroundColor3=Color3.fromRGB(50,90,50)
			placeBtn.TextColor3=C.text
		end
	else
		stopAll()
	end
end)

local loadedBlocks = {}

loadBtn.MouseButton1Click:Connect(function()
	local code = bpBox.Text
	if code=="" then
		setStatus("⚠  Paste a blueprint first",C.warn); return
	end
	loadedBlocks = parseBlueprint(code)
	if #loadedBlocks==0 then
		setStatus("⚠  Could not parse blueprint",C.warn)
		partLbl.Text=""; return
	end
	partLbl.Text = #loadedBlocks.." parts"
	setStatus("✔  Loaded "..#loadedBlocks.." parts", Color3.fromRGB(80,200,110))
	placeBtn.BackgroundColor3=Color3.fromRGB(50,90,50)
	placeBtn.TextColor3=C.text
end)

placeBtn.MouseButton1Click:Connect(function()
	if state == STATE.IDLE then
		if #loadedBlocks==0 then
			setStatus("⚠  Load a blueprint first",C.warn); return
		end
		local plot = getPlot()
		if not plot then
			setStatus("⚠  Plot not found",C.warn); return
		end
		beginPlacement(loadedBlocks, plot)
	elseif state == STATE.MOVING then
		-- GUI button acts as anchor too
		frozenOrigin = getMouseGroundPos()
		applyOriginToGhost(frozenOrigin)
		state = STATE.ANCHORED
		setStatus("Anchored — click again to print, Cancel to reposition",
			Color3.fromRGB(220,180,60))
		placeBtn.Text="🖨  Print Here"
		placeBtn.BackgroundColor3=Color3.fromRGB(60,110,180)
		placeBtn.TextColor3=C.text
	elseif state == STATE.ANCHORED then
		state = STATE.PRINTING
		task.spawn(runPrint, frozenOrigin)
	end
end)

