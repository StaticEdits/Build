local function round(n, step)
	return math.floor(n / step + 0.5) * step
end

local function getBlockKey(id, relCF, sizeX, sizeY, sizeZ, hex)
	local p = relCF.Position
	local _,_,_,r00,r01,r02,r10,r11,r12,r20,r21,r22 = relCF:GetComponents()
	return string.format("%s|%.1f,%.1f,%.1f|%.1f,%.1f,%.1f|%s|%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f",
		id,
		round(p.X,0.1), round(p.Y,0.1), round(p.Z,0.1),
		round(sizeX,0.1), round(sizeY,0.1), round(sizeZ,0.1),
		hex,
		round(r00,0.01),round(r01,0.01),round(r02,0.01),
		round(r10,0.01),round(r11,0.01),round(r12,0.01),
		round(r20,0.01),round(r21,0.01),round(r22,0.01)
	)
end

local function getExistingMap(plot)
	local map = {}
	local terrainBase     = plot:FindFirstChild("Terrain") and plot.Terrain:FindFirstChild("Grass")
	local furnitureFolder = plot:FindFirstChild("ActiveAssets") and plot.ActiveAssets:FindFirstChild("Furniture")
	if not terrainBase or not furnitureFolder then return map end

	local grassCF = terrainBase.CFrame
	local count   = 0

	for _, model in ipairs(furnitureFolder:GetChildren()) do
		local item  = model:FindFirstChild("Item")
		local color = model:FindFirstChild("Color")
		if not (item and color) then continue end

		local id = furnitureIdCache[string.lower(item.Value)]
		if not id then continue end

		for _, part in ipairs(model:GetDescendants()) do
			if part:IsA("BasePart") then
				local relCF = grassCF:ToObjectSpace(part.CFrame)
				local key   = getBlockKey(id, relCF, part.Size.X, part.Size.Y, part.Size.Z, colorToHex(part.Color))
				map[key]    = true
				count      += 1
				if count % 100 == 0 then task.wait() end
			end
		end
	end

	return map
end

