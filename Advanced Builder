local function makeTextBox(parent, h, yPos)
	local box = Instance.new("TextBox")
	box.Size             = UDim2.new(1, 0, 0, h)
	box.Position         = UDim2.new(0, 0, 0, yPos)
	box.BackgroundColor3 = C.input
	box.TextColor3       = C.text
	box.TextWrapped      = true
	box.MultiLine        = true
	box.ClearTextOnFocus = false
	box.BorderSizePixel  = 0
	box.Font             = Enum.Font.Code
	box.TextSize         = 11
	box.Text             = ""
	box.Parent           = parent
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, 5)
	local p = Instance.new("UIPadding", box)
	p.PaddingLeft = UDim.new(0, 6); p.PaddingRight = UDim.new(0, 6)
	p.PaddingTop  = UDim.new(0, 4); p.PaddingBottom = UDim.new(0, 4)
	return box
end

local function rebuildExportView()
	if exportView then exportView:Destroy() end
	exportBoxes  = {}
	exportLabels = {}
	exportWarnLabel.Visible = false

	-- scrollable area above the action bar
	local scrollH = contentH - 40

	exportView = Instance.new("Frame")
	exportView.Size               = UDim2.new(1, 0, 0, scrollH)
	exportView.Position           = UDim2.new(0, 0, 0, 0)
	exportView.BackgroundTransparency = 1
	exportView.Parent             = contentFrame

	-- Header row: label + total counter
	local headerRow = Instance.new("Frame")
	headerRow.Size             = UDim2.new(1, 0, 0, 22)
	headerRow.BackgroundTransparency = 1
	headerRow.Parent           = exportView

	local boxLabel = Instance.new("TextLabel")
	boxLabel.Size               = UDim2.new(0.5, 0, 1, 0)
	boxLabel.BackgroundTransparency = 1
	boxLabel.Text               = settings.biggerExporter and "Export Boxes" or "Blueprint Code"
	boxLabel.TextColor3         = C.textMuted
	boxLabel.Font               = Enum.Font.GothamBold
	boxLabel.TextSize           = 12
	boxLabel.TextXAlignment     = Enum.TextXAlignment.Left
	boxLabel.Parent             = headerRow

	totalPartsLabel = Instance.new("TextLabel")
	totalPartsLabel.Size               = UDim2.new(0.5, 0, 1, 0)
	totalPartsLabel.Position           = UDim2.new(0.5, 0, 0, 0)
	totalPartsLabel.BackgroundTransparency = 1
	totalPartsLabel.TextColor3         = C.textMuted
	totalPartsLabel.Font               = Enum.Font.Gotham
	totalPartsLabel.TextSize           = 12
	totalPartsLabel.Text               = "Total parts: —"
	totalPartsLabel.TextXAlignment     = Enum.TextXAlignment.Right
	totalPartsLabel.Parent             = headerRow

	if not settings.biggerExporter then
		-- NORMAL: single box
		local box = makeTextBox(exportView, scrollH - 26, 26)
		table.insert(exportBoxes, box)
		table.insert(exportLabels, totalPartsLabel)
	else
		-- BIGGER: scrolling multi-box
		local scroll = Instance.new("ScrollingFrame")
		scroll.Size                 = UDim2.new(1, 0, 0, scrollH - 26)
		scroll.Position             = UDim2.new(0, 0, 0, 26)
		scroll.BackgroundTransparency = 1
		scroll.ScrollBarThickness   = 4
		scroll.ScrollBarImageColor3 = C.border
		scroll.BorderSizePixel      = 0
		scroll.Parent               = exportView

		local BOX_H   = 72
		local LABEL_H = 20
		local GAP     = 8
		local cy      = 4

		for i = 1, MAX_BOXES do
			local rowBg = Instance.new("Frame")
			rowBg.Size             = UDim2.new(1, -4, 0, LABEL_H + BOX_H + 6)
			rowBg.Position         = UDim2.new(0, 0, 0, cy)
			rowBg.BackgroundColor3 = C.card
			rowBg.BorderSizePixel  = 0
			rowBg.Parent           = scroll
			Instance.new("UICorner", rowBg).CornerRadius = UDim.new(0, 6)

			local lbl = Instance.new("TextLabel")
			lbl.Size             = UDim2.new(1, -10, 0, LABEL_H)
			lbl.Position         = UDim2.new(0, 8, 0, 3)
			lbl.BackgroundTransparency = 1
			lbl.TextColor3       = C.textMuted
			lbl.Font             = Enum.Font.GothamBold
			lbl.TextSize         = 11
			lbl.Text             = "Box " .. i .. " — 0 parts"
			lbl.TextXAlignment   = Enum.TextXAlignment.Left
			lbl.Parent           = rowBg

			local box = Instance.new("TextBox")
			box.Size             = UDim2.new(1, -10, 0, BOX_H)
			box.Position         = UDim2.new(0, 5, 0, LABEL_H + 4)
			box.BackgroundColor3 = C.input
			box.TextColor3       = C.text
			box.TextWrapped      = true
			box.MultiLine        = true
			box.ClearTextOnFocus = false
			box.BorderSizePixel  = 0
			box.Font             = Enum.Font.Code
			box.TextSize         = 10
			box.Text             = ""
			box.Parent           = rowBg
			Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)
			local bp = Instance.new("UIPadding", box)
			bp.PaddingLeft = UDim.new(0, 5); bp.PaddingRight = UDim.new(0, 5)
			bp.PaddingTop  = UDim.new(0, 3); bp.PaddingBottom = UDim.new(0, 3)

			cy += LABEL_H + BOX_H + 6 + GAP

			table.insert(exportBoxes,  box)
			table.insert(exportLabels, lbl)
		end
		scroll.CanvasSize = UDim2.new(0, 0, 0, cy)
	end
end

