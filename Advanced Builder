function exportBlueprint()
	local plot = getPlot(playerBox.Text)
	if not plot then warn("Plot not found") return end

	local terrainBase = plot:FindFirstChild("Terrain") and plot.Terrain:FindFirstChild("Grass")
	if not terrainBase then warn("Terrain.Grass not found") return end

	local furnitureFolder = plot:FindFirstChild("ActiveAssets") and plot.ActiveAssets:FindFirstChild("Furniture")
	if not furnitureFolder then warn("No furniture found") return end

	local blocks = {}
	for _,model in ipairs(furnitureFolder:GetChildren()) do
		local item  = model:FindFirstChild("Item")
		local color = model:FindFirstChild("Color")
		if item and color and isAllowedItem(item.Value) then
			local id = furnitureIdCache[string.lower(item.Value)]
			if not id then continue end

			for _,part in ipairs(model:GetDescendants()) do
				if part:IsA("BasePart") then
					local rel = terrainBase.CFrame:ToObjectSpace(part.CFrame)
					table.insert(blocks, table.concat({
						id,
						cfToString(rel),
						model.Color.Value,
						sizeToString(part.Size),
						colorToHex(part.Color)
					}, "|"))
				end
			end
		end
	end

	if #blocks == 0 then warn("No valid parts found") return end

	totalPartsLabel.Text = "Total parts: " .. #blocks

	if not settings.biggerExporter then
		if #blocks > PARTS_PER_BOX then
			exportBoxes[1].Text     = ""
			exportWarnLabel.Visible = true
			warn("Over 700 parts (" .. #blocks .. ") — enable Bigger Exporter in Settings!")
			return
		end
		exportWarnLabel.Visible = false
		exportBoxes[1].Text     = table.concat(blocks, ";")
	else
		exportWarnLabel.Visible = false
		local idx = 1
		for i, box in ipairs(exportBoxes) do
			local chunk = {}
			for _ = 1, PARTS_PER_BOX do
				if idx > #blocks then break end
				table.insert(chunk, blocks[idx])
				idx += 1
			end
			box.Text             = table.concat(chunk, ";")
			exportLabels[i].Text = "Box " .. i .. " — " .. #chunk .. " parts"
		end
	end

	local full  = table.concat(blocks, ";")
	local value = plot:FindFirstChild("Blueprint") or Instance.new("StringValue")
	value.Name   = "Blueprint"
	value.Value  = full
	value.Parent = plot

	print("Blueprint exported! Total parts:", #blocks)
end

