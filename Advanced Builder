local function makeToggleRow(labelText, yPos, isOn)
	local row = Instance.new("Frame")
	row.Size             = UDim2.new(1,-20,0,38)
	row.Position         = UDim2.new(0,10,0,yPos)
	row.BackgroundColor3 = Color3.fromRGB(40,40,48)
	row.BorderSizePixel  = 0
	row.ZIndex           = 11
	row.Parent           = settingsPanel

	local lbl = Instance.new("TextLabel")
	lbl.Size               = UDim2.new(1,-70,1,0)
	lbl.Position           = UDim2.new(0,10,0,0)
	lbl.BackgroundTransparency = 1
	lbl.Text               = labelText
	lbl.TextColor3         = Color3.new(1,1,1)
	lbl.Font               = Enum.Font.SourceSans
	lbl.TextScaled         = true
	lbl.TextXAlignment     = Enum.TextXAlignment.Left
	lbl.ZIndex             = 12
	lbl.Parent             = row

	local toggle = Instance.new("TextButton")
	toggle.Size             = UDim2.new(0,52,0,26)
	toggle.Position         = UDim2.new(1,-60,0.5,-13)
	toggle.BorderSizePixel  = 0
	toggle.Font             = Enum.Font.SourceSansBold
	toggle.TextScaled       = true
	toggle.ZIndex           = 12
	toggle.Parent           = row

	local function refreshToggle(on)
		toggle.Text             = on and "ON" or "OFF"
		toggle.BackgroundColor3 = on and Color3.fromRGB(60,160,80) or Color3.fromRGB(120,50,50)
		toggle.TextColor3       = Color3.new(1,1,1)
	end

	refreshToggle(isOn)
	return toggle, refreshToggle
end

