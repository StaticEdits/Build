local function makeToggleRow(labelText, descText, yPos, isOn)
	local row = Instance.new("Frame")
	row.Size             = UDim2.new(1, -32, 0, 54)
	row.Position         = UDim2.new(0, 16, 0, yPos)
	row.BackgroundColor3 = C.card
	row.BorderSizePixel  = 0
	row.ZIndex           = 11
	row.Parent           = settingsPanel
	Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
	Instance.new("UIStroke", row).Color = C.border

	local lbl = Instance.new("TextLabel")
	lbl.Size               = UDim2.new(1, -70, 0, 22)
	lbl.Position           = UDim2.new(0, 12, 0, 8)
	lbl.BackgroundTransparency = 1
	lbl.Text               = labelText
	lbl.TextColor3         = C.text
	lbl.Font               = Enum.Font.GothamBold
	lbl.TextSize           = 13
	lbl.TextXAlignment     = Enum.TextXAlignment.Left
	lbl.ZIndex             = 12
	lbl.Parent             = row

	local desc = Instance.new("TextLabel")
	desc.Size               = UDim2.new(1, -70, 0, 16)
	desc.Position           = UDim2.new(0, 12, 0, 30)
	desc.BackgroundTransparency = 1
	desc.Text               = descText
	desc.TextColor3         = C.textMuted
	desc.Font               = Enum.Font.Gotham
	desc.TextSize           = 11
	desc.TextXAlignment     = Enum.TextXAlignment.Left
	desc.ZIndex             = 12
	desc.Parent             = row

	local toggle = Instance.new("TextButton")
	toggle.Size             = UDim2.new(0, 52, 0, 26)
	toggle.Position         = UDim2.new(1, -62, 0.5, -13)
	toggle.BorderSizePixel  = 0
	toggle.Font             = Enum.Font.GothamBold
	toggle.TextSize         = 12
	toggle.ZIndex           = 12
	toggle.Parent           = row
	Instance.new("UICorner", toggle).CornerRadius = UDim.new(0, 13)

	local function refreshToggle(on)
		toggle.Text             = on and "ON" or "OFF"
		toggle.BackgroundColor3 = on and C.success or Color3.fromRGB(90, 40, 40)
		toggle.TextColor3       = C.text
	end
	refreshToggle(isOn)
	return toggle, refreshToggle
end

