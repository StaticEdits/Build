local function round(n, step)
	return math.floor(n / step + 0.5) * step
end

local function makeKey(id, relCF, size, palette, offsetCF)
	local p = relCF.Position
	local _,_,_, r00,r01,r02,r10,r11,r12,r20,r21,r22 = relCF:GetComponents()

	local sizeStr = "None"
	if size then
		sizeStr = string.format("%.1f,%.1f,%.1f",
			round(size.X, 0.1), round(size.Y, 0.1), round(size.Z, 0.1))
	end

	local offStr = "none"
	if offsetCF then
		local op = offsetCF.Position
		offStr = string.format("%.2f,%.2f,%.2f",
			round(op.X, 0.01), round(op.Y, 0.01), round(op.Z, 0.01))
	end

	return string.format(
		"%s|%.1f,%.1f,%.1f|%s|%s|%s|%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f",
		tostring(id),
		round(p.X, 0.1), round(p.Y, 0.1), round(p.Z, 0.1),
		sizeStr,
		table.concat(palette, ","),
		offStr,
		round(r00,0.01), round(r01,0.01), round(r02,0.01),
		round(r10,0.01), round(r11,0.01), round(r12,0.01),
		round(r20,0.01), round(r21,0.01), round(r22,0.01)
	)
end

