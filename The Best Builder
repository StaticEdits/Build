local function diagModel(model, reference, idx)
	local id, itemName = resolveFurnitureId(model), getModelItemName(model)
	local pivot = model:GetPivot()
	local bbCF, bbSize = model:GetBoundingBox()
	local bbBottom = bbCF.Position.Y - bbSize.Y / 2
	local pivotMinusBottom = pivot.Position.Y - bbBottom

	local currentSize  = model:GetAttribute("CurrentSize")
	local originalSize = model:GetAttribute("OriginalSize")
	local scaleVector  = model:GetAttribute("ScaleVector")
	local offset       = model:GetAttribute("OriginalOffset")
	local minS = model:GetAttribute("Min")
	local maxS = model:GetAttribute("Max")
	local colorAttr = model:GetAttribute("Color")
	local surface    = getPlacementSurface(model)

	dbg("[D#%d] '%s' id=%s item=%s", idx, model.Name, tostring(id), tostring(itemName))
	dbg("  instance pivot      = %s", cfToReadable(pivot))
	dbg("  instance bboxCenter = %s  size=%s", cfToReadable(bbCF), vecToStr(bbSize))
	dbg("  instance bboxBottom = %.5f  pivotY=%.5f  pivot-bottom=%+.5f",
		bbBottom, pivot.Position.Y, pivotMinusBottom)
	dbg("  CurrentSize  = %s", currentSize and vecToStr(currentSize) or "nil")
	dbg("  OriginalSize = %s", originalSize and vecToStr(originalSize) or "nil")
	dbg("  ScaleVector  = %s", scaleVector and vecToStr(scaleVector) or "nil")
	dbg("  OriginalOffset = %s", offset and cfToReadable(offset) or "nil")
	dbg("  PlacementSurface = %s (informational only)", tostring(surface))
	dbg("  Min=%s  Max=%s  Color=%s", tostring(minS), tostring(maxS), tostring(colorAttr))

	local _,_,_, r00,r01,r02,r10,r11,r12,r20,r21,r22 = pivot:GetComponents()
	dbg("  basis right=(%+.4f,%+.4f,%+.4f) up=(%+.4f,%+.4f,%+.4f) look=(%+.4f,%+.4f,%+.4f)",
		r00,r01,r02, r10,r11,r12, r20,r21,r22)

	if reference then
		local rel = reference.CFrame:ToObjectSpace(pivot)
		local rp = rel.Position
		dbg("  relCFrame pos (pivot-verbatim, USED BY EXPORT) = (%.5f,%.5f,%.5f)",
			rp.X, rp.Y, rp.Z)
		-- Diagnostic only: what a face-anchored export would have sent.
		local faceAnchor = surfaceAnchor(pivot, bbSize, surface)
		local faceRel = reference.CFrame:ToObjectSpace(faceAnchor)
		local fp = faceRel.Position
		dbg("  face-anchored rel pos (DIAGNOSTIC ONLY, NOT EXPORTED) = (%.5f,%.5f,%.5f)",
			fp.X, fp.Y, fp.Z)
	end

	local tmplButton = getTemplate(id)
	if tmplButton then
		local tmplModel = findTemplateModel(tmplButton)
		if tmplModel then
			local tPivot = tmplModel:GetPivot()
			local tCF, tSize = tmplModel:GetBoundingBox()
			local tBottom = tCF.Position.Y - tSize.Y / 2
			local tPivotMinusBottom = tPivot.Position.Y - tBottom
			local tOffset = tmplModel:GetAttribute("OriginalOffset")
			local tOriginalSize = tmplModel:GetAttribute("OriginalSize")
			local tSurface = tmplModel:GetAttribute("PlacementSurface")
				or tmplModel:GetAttribute("Surface_Default")

			dbg("  TEMPLATE pivot=%s", cfToReadable(tPivot))
			dbg("  TEMPLATE bboxBottom=%.5f  pivot-bottom=%+.5f", tBottom, tPivotMinusBottom)
			dbg("  TEMPLATE bbox size=%s  OriginalSize=%s",
				vecToStr(tSize), tOriginalSize and vecToStr(tOriginalSize) or "nil")
			dbg("  TEMPLATE OriginalOffset=%s",
				tOffset and cfToReadable(tOffset) or "nil")
			dbg("  TEMPLATE PlacementSurface=%s", tostring(tSurface or "nil"))

			local anchorDelta = pivotMinusBottom - tPivotMinusBottom
			dbg("  >>> ANCHOR DELTA (inst - tmpl) = %+.5f", anchorDelta)

			local sdx, sdy, sdz = bbSize.X - tSize.X, bbSize.Y - tSize.Y, bbSize.Z - tSize.Z
			dbg("  >>> SIZE DELTA inst-tmpl = (%+.4f,%+.4f,%+.4f)", sdx, sdy, sdz)

			local dot     = pivot.LookVector:Dot(tPivot.LookVector)
			local dotUp   = pivot.UpVector:Dot(tPivot.UpVector)
			local dotRight= pivot.RightVector:Dot(tPivot.RightVector)
			local angLook = math.deg(math.acos(math.clamp(dot, -1, 1)))
			local angUp   = math.deg(math.acos(math.clamp(dotUp, -1, 1)))
			local angRight= math.deg(math.acos(math.clamp(dotRight, -1, 1)))
			dbg("  >>> ORIENTATION DELTA deg  look=%.2f up=%.2f right=%.2f", angLook, angUp, angRight)
		else
			dbg("  TEMPLATE model not found under button '%s'", tmplButton:GetFullName())
		end
	else
		dbg("  TEMPLATE not found for id=%s", tostring(id))
	end
	dbg("")
end

