--------------------------------------------------
-- DEBUG: DIFF TEMPLATES (one line per distinct id)
--------------------------------------------------

debugDiffBtn.MouseButton1Click:Connect(function()
	local target = getBuildTarget(getPlayerName())
	if not target then dbg("DIFF: no target") refreshDebugView() return end

	dbg("==================================================")
	dbg("DIFF TEMPLATES  ref=%s", target.reference:GetFullName())

	local seen = {}
	local rows = {}
	for _, model in ipairs(getFurnitureModels(target.furniture)) do
		local id = resolveFurnitureId(model)
		if id and not seen[id] then
			seen[id] = true
			local pivot = model:GetPivot()
			local bbCF, bbSize = model:GetBoundingBox()
			local bbBottom = bbCF.Position.Y - bbSize.Y / 2
			local pMinusB = pivot.Position.Y - bbBottom
			local surface = getPlacementSurface(model)

			local tmplButton = getTemplate(id)
			local tmplModel = tmplButton and findTemplateModel(tmplButton) or nil
			local anchorDelta, sizeDelta, angLook, hasTemplate = 0, Vector3.new(), 0, false
			local tSurface
			if tmplModel then
				local tPivot = tmplModel:GetPivot()
				local tCF, tSize = tmplModel:GetBoundingBox()
				local tBottom = tCF.Position.Y - tSize.Y / 2
				local tPMinusB = tPivot.Position.Y - tBottom
				anchorDelta = pMinusB - tPMinusB
				sizeDelta   = bbSize - tSize
				angLook     = math.deg(math.acos(math.clamp(
					pivot.LookVector:Dot(tPivot.LookVector), -1, 1)))
				tSurface    = tmplModel:GetAttribute("PlacementSurface")
					or tmplModel:GetAttribute("Surface_Default")
				hasTemplate = true
			end

			rows[#rows + 1] = {
				id = id, name = model.Name,
				anchorDelta = anchorDelta, sizeDelta = sizeDelta,
				angLook = angLook, hasTemplate = hasTemplate,
				pMinusB = pMinusB, surface = surface, tSurface = tSurface,
			}
		end
	end

	table.sort(rows, function(a, b) return tostring(a.id) < tostring(b.id) end)
	for _, r in ipairs(rows) do
		if r.hasTemplate then
			dbg("id=%-5s %-28s surf=%-6s tmplSurf=%-6s p-b=%+.4f  anchorD=%+.4f  sizeD=(%+.3f,%+.3f,%+.3f)  lookD=%.1f deg",
				tostring(r.id), r.name, tostring(r.surface), tostring(r.tSurface or "nil"),
				r.pMinusB, r.anchorDelta,
				r.sizeDelta.X, r.sizeDelta.Y, r.sizeDelta.Z, r.angLook)
		else
			dbg("id=%-5s %-28s surf=%-6s p-b=%+.4f  (no template found)",
				tostring(r.id), r.name, tostring(r.surface), r.pMinusB)
		end
	end
	dbg("DIFF done: %d distinct ids", #rows)
	refreshDebugView()
end)

