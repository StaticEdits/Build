importTab.MouseButton1Click:Connect(function() switchTab("Import") end)
debugTab.MouseButton1Click:Connect(function() switchTab("Debug") end)

playerBox.FocusLost:Connect(function()
	local typed = playerBox.Text
	if typed == "" then return end
	local lower = string.lower(typed)
	for _, p in ipairs(Players:GetPlayers()) do
		if string.sub(string.lower(p.DisplayName), 1, #lower) == lower
			or string.sub(string.lower(p.Name),        1, #lower) == lower then
			playerBox.Text = p.Name
			break
		end
	end
end)

