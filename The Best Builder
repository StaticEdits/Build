-- EXISTING MAP
--------------------------------------------------

local function getFurnitureModels(folder)
	local out = {}
	for _, o in ipairs(folder:GetDescendants()) do
		if o:IsA("Model") then out[#out + 1] = o end
	end
	return out
end

local function getExistingMap(target)
	local map = {}
	for _, model in ipairs(getFurnitureModels(target.furniture)) do
		local id = resolveFurnitureId(model)
		if id then
			if isBuildingBlockId(id) then
				-- Building blocks use the first script's per-BasePart key.
				local colorValue = model:FindFirstChild("Color")
				local itemValue = model:FindFirstChild("Item")
				-- Building-block dupe detection works for every target type.
				if colorValue and itemValue then
					for _, part in ipairs(model:GetDescendants()) do
						if part:IsA("BasePart") then
							local rel = target.reference.CFrame:ToObjectSpace(part.CFrame)
							map[getBlockKey(id, rel, part.Size, colorToHex(part.Color))] = true
						end
					end
				end
			else
				local pivot, _, size, offset = readModelPlacement(model)
				local rel = target.reference.CFrame:ToObjectSpace(pivot)
				local palette = getModelPalette(model)
				map[makeKey(id, rel, size, palette, offset)] = true
			end
		end
	end
	return map
end
--------------------------------------------------
-- EXPORT
--------------------------------------------------
--
-- UNIVERSAL: export writes the pivot CFrame verbatim. No bbox-bottom
-- substitution, no surface anchoring, no per-id branching. This matches
-- the remote's actual placement rule (place pivot at CFrame, apply
-- OriginalOffset for resize only) for every piece.

local function exportBlueprint()
	local target = getBuildTarget(getPlayerName())
	if not target then return end

	dbg("==================================================")
	dbg("EXPORT start  target=%s  ref=%s", target.kind, target.reference:GetFullName())
	dbg("  reference cframe = %s", cfToReadable(target.reference.CFrame))

	local entries = {}
	for _, model in ipairs(getFurnitureModels(target.furniture)) do
		local id = resolveFurnitureId(model)
		local itemName = getModelItemName(model)
		if id and itemName then
			if isBuildingBlockId(id) then
				-- Export blocks on House, Car, Trailer, and Boat.
				-- Keep the original five-field, per-BasePart blueprint format.
				local colorValue = model:FindFirstChild("Color")
				if colorValue then
					local blockCount = 0
					for _, part in ipairs(model:GetDescendants()) do
						if part:IsA("BasePart") then
							local rel = target.reference.CFrame:ToObjectSpace(part.CFrame)
							entries[#entries + 1] = table.concat({
								tostring(id), cfToString(rel), tostring(colorValue.Value),
								sizeToString(part.Size), colorToHex(part.Color),
							}, "|")
							blockCount += 1
						end
					end
					dbg("    EXPORTED %d block parts id=%s target=%s",
						blockCount, tostring(id), target.kind)
				else
					dbg("    BLOCK SKIPPED: missing Color value id=%s", tostring(id))
				end
			else
				-- All non-block furniture keeps script 2's model/pivot format.
				local colorHandle = model:GetAttribute("Color")
				local pivot, bottomY, currentSize, offset = readModelPlacement(model)
				local rel = target.reference.CFrame:ToObjectSpace(pivot)
				dbg("    EXP id=%s surf=%s pivot=%s bboxBottomY=%.4f rel=%s",
					tostring(id), tostring(getPlacementSurface(model)), cfToReadable(pivot), bottomY, cfToReadable(rel))
				local palette = getModelPalette(model)
				local sizeStr = (isResizable(model) and currentSize) and sizeToString(currentSize) or "None"
				local offsetStr = offset and cfToString(offset) or ""
				entries[#entries + 1] = table.concat({
					tostring(id), cfToString(rel), tostring(colorHandle or ""),
					sizeStr, table.concat(palette, ","), offsetStr,
				}, "|")
			end
		end
	end

	if #entries == 0 then
		warn("No valid furniture found under:", target.furniture:GetFullName())
		return
	end
	totalPartsLabel.Text = "Entries: " .. #entries
	dbg("EXPORT done: %d entries", #entries)

	if not settings.biggerExporter then
		if #entries > PARTS_PER_BOX then
			exportBoxes[1].Text = ""; exportWarnLabel.Visible = true
			warn("Over " .. PARTS_PER_BOX .. " entries — enable Bigger Exporter")
			refreshDebugView(); return
		end
		exportWarnLabel.Visible = false
		exportBoxes[1].Text = table.concat(entries, ";")
	else
		exportWarnLabel.Visible = false
		local idx = 1
		for i, box in ipairs(exportBoxes) do
			local chunk = {}
			for _ = 1, PARTS_PER_BOX do
				if idx > #entries then break end
				chunk[#chunk + 1] = entries[idx]; idx += 1
			end
			box.Text = table.concat(chunk, ";")
			exportLabels[i].Text = "Box " .. i .. " — " .. #chunk .. " entries"
		end
		if idx <= #entries then warn("Exceeds capacity of " .. MAX_BOXES .. " boxes") end
	end

	local blueprint = target.instance:FindFirstChild("Blueprint")
	if not blueprint then blueprint = Instance.new("StringValue"); blueprint.Name = "Blueprint"; blueprint.Parent = target.instance end
	blueprint.Value = table.concat(entries, ";")
	print(target.kind .. " blueprint exported:", #entries, "entries")
	refreshDebugView()
end
exportActionBtn.MouseButton1Click:Connect(exportBlueprint)

--------------------------------------------------
-- IMPORT
--------------------------------------------------
--
-- UNIVERSAL: send RelativeCFrame verbatim. No OriginalOffset subtraction.
-- offsetCF is still parsed for the dupe key, never applied to placement.

local function importBlueprint()
	if importRunning then return end

	local target = getBuildTarget(getPlayerName())
	if not target then return end

	local code = blueprintBox.Text
	if code == "" then warn("No blueprint code") return end

	local placingName = getPlayerName()
	local placingFromUser = Players:FindFirstChild(placingName)
	if not placingFromUser then
		warn("Selected player not in server:", placingName); return
	end

	importRunning, importPaused = true, false

	runBtn.Text             = "Running…"
	runBtn.BackgroundColor3 = C.card
	runBtn.TextColor3       = C.textMuted
	pauseBtn.Visible        = true
	pauseBtn.BackgroundColor3 = C.pause
	pauseBtn.Text           = "⏸  Pause"
	pauseBtn.TextColor3     = C.text
	progressLabel.TextColor3 = C.textMuted

	dbg("==================================================")
	dbg("IMPORT start  target=%s  ref=%s",
		target.kind, target.reference:GetFullName())
	dbg("  reference cframe = %s", cfToReadable(target.reference.CFrame))

	local existingMap = {}
	if settings.dupeSafety then
		progressLabel.Text = "Scanning existing furniture…"
		existingMap = getExistingMap(target)
	end

	local entries = string.split(code, ";")
	local total   = #entries
	local placed, skipped, failed = 0, 0, 0

	for idx, entry in ipairs(entries) do
		while importPaused do task.wait(0.1) end

		if entry ~= "" then
			local data = string.split(entry, "|")
			local id = data[1]
			local relCF = stringToCFrame(data[2])
			local color = data[3]
			local isBlockEntry = isBuildingBlockId(id) and #data == 5

			if isBlockEntry then
				-- Original building-block format: id|part CFrame|model Color|part Size|part hex.
				local partSize = stringToSize(data[4])
				local hex = data[5]
				if not (id and relCF and color and partSize and hex) then
					failed += 1; dbg("    FAILED block parse"); warn("Invalid block entry:", entry)
				else
					local key = getBlockKey(id, relCF, partSize, hex)
					if settings.dupeSafety and existingMap[key] then
						skipped += 1; dbg("    SKIPPED block by dupe safety")
					else
						if settings.dupeSafety then existingMap[key] = true end
						local finalRelCFrame = relCF * CFrame.new(0, -partSize.Y / 2, 0)
						local args = {
							PurchaseForPlace = true, Id = id,
							RelativeCFrame = finalRelCFrame, Color = color,
							Size = {X=partSize.X*10, Y=partSize.Y*10, Z=partSize.Z*10, P=10},
							CustomColors = {hex}, PlacingFromUser = placingFromUser,
						}
						-- Match the normal furniture target contract.
						if target.kind == "House" then
							args.House = target.instance
						else
							args.Vehicle = target.instance
						end

						local ok, err = pcall(function()
							return PlaceFurnitureRemote:InvokeServer(args)
						end)
						if ok then
							placed += 1
							dbg("    ✔ block part placed on %s", target.kind)
						else
							failed += 1
							dbg("    ✖ BLOCK FAILED: %s", tostring(err))
							warn("Block placement failed:", err)
						end
					end
				end
			else
				-- Original script 2 format: model pivot is sent verbatim.
				local size = stringToSize(data[4])
				local palette = parsePalette(data[5])
				local offsetCF = (data[6] and data[6] ~= "") and stringToCFrame(data[6]) or nil
				dbg("--- IMP #%d id=%s size=%s color=%s offset=%s relPos=(%.4f,%.4f,%.4f)",
					idx, tostring(id), size and vecToStr(size) or "None", tostring(color),
					offsetCF and cfToReadable(offsetCF) or "none",
					relCF and relCF.Position.X or 0, relCF and relCF.Position.Y or 0, relCF and relCF.Position.Z or 0)
				if not (id and relCF and color) then
					failed += 1; dbg("    FAILED parse"); warn("Invalid entry:", entry)
				else
					local key = makeKey(id, relCF, size, palette, offsetCF)
					if settings.dupeSafety and existingMap[key] then
						skipped += 1; dbg("    SKIPPED by dupe safety")
					else
						if settings.dupeSafety then existingMap[key] = true end
						local args = {PurchaseForPlace=true, Id=id, RelativeCFrame=relCF, Color=color, PlacingFromUser=placingFromUser}
						if target.kind == "House" then args.House = target.instance else args.Vehicle = target.instance end
						if size then args.Size = {X=size.X*10, Y=size.Y*10, Z=size.Z*10, P=10} end
						if not settings.defaultColor then args.CustomColors = palette end
						local ok, err = pcall(function() return PlaceFurnitureRemote:InvokeServer(args) end)
						if ok then placed += 1; dbg("    ✔ placed")
						else failed += 1; dbg("    ✖ FAILED: %s", tostring(err)); warn("Placement failed:", err) end
					end
				end
			end

			progressLabel.Text =
				"Placed " .. placed .. " / " .. total ..
				" | Skipped " .. skipped ..
				" | Failed "  .. failed
		end
	end

	importRunning, importPaused = false, false

	dbg("IMPORT done: placed=%d skipped=%d failed=%d",
		placed, skipped, failed)

	progressLabel.Text       = "✔  Done! Placed: " .. placed ..
		" | Skipped: " .. skipped ..
		" | Failed: "  .. failed
	progressLabel.TextColor3 = C.success
	runBtn.Text              = "▶  Run Blueprint"
	runBtn.BackgroundColor3  = C.accent
	runBtn.TextColor3        = C.text
	pauseBtn.Visible         = false
	refreshDebugView()
end

