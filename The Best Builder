local function findTemplateModel(button)
	if not button then return nil end
	if button:IsA("Model") then return button end
	for _, d in ipairs(button:GetChildren()) do
		if d:IsA("Model") then return d end
	end
	for _, d in ipairs(button:GetDescendants()) do
		if d:IsA("Model") then return d end
	end
	return nil
end

local function cacheFurniture(button)
	if not button:IsA("ImageButton") then return end
	local id = button:FindFirstChild("Id")
	if id then
		furnitureIdCache[string.lower(button.Name)] = id.Value
		templateById[tostring(id.Value)] = button
	end
end

