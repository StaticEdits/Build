local debugBuffer = {}
local DEBUG_MAX_LINES = 6000

local function dbg(fmt, ...)
	local line
	if select("#", ...) > 0 then
		local ok, formatted = pcall(string.format, fmt, ...)
		line = ok and formatted or tostring(fmt)
	else
		line = tostring(fmt)
	end
	debugBuffer[#debugBuffer + 1] = line
	if #debugBuffer > DEBUG_MAX_LINES then
		table.remove(debugBuffer, 1)
	end
	print("[BPM] " .. line)
end

local function dbgClear() debugBuffer = {} end
local function dbgText() return table.concat(debugBuffer, "\n") end

