local function cfToString(cf)
	local c = {cf:GetComponents()}
	for i, v in ipairs(c) do c[i] = string.format("%.5f", v) end
	return table.concat(c, ",")
end

local function cfToReadable(cf)
	if not cf then return "nil" end
	local p = cf.Position
	return string.format("pos(%.3f,%.3f,%.3f)", p.X, p.Y, p.Z)
end

local function stringToCFrame(s)
	if not s or s == "" then return nil end
	local n = {}
	for v in string.gmatch(s, "[^,]+") do n[#n + 1] = tonumber(v) end
	if #n ~= 12 then return nil end
	for _, v in ipairs(n) do if v == nil then return nil end end
	return CFrame.new(table.unpack(n))
end

local function sizeToString(v)
	if not v then return "None" end
	return string.format("%.5f,%.5f,%.5f", v.X, v.Y, v.Z)
end

local function stringToSize(s)
	if not s or s == "None" then return nil end
	local n = {}
	for v in string.gmatch(s, "[^,]+") do n[#n + 1] = tonumber(v) end
	if #n ~= 3 or not (n[1] and n[2] and n[3]) then return nil end
	return Vector3.new(n[1], n[2], n[3])
end

local function colorToHex(c)
	local r = math.clamp(math.floor(c.R * 255 + 0.5), 0, 255)
	local g = math.clamp(math.floor(c.G * 255 + 0.5), 0, 255)
	local b = math.clamp(math.floor(c.B * 255 + 0.5), 0, 255)
	return string.format("%02X%02X%02X", r, g, b)
end

local function parsePalette(s)
	local out = {}
	for hex in string.gmatch(s or "", "[^,]+") do
		hex = string.gsub(hex, "%s", "")
		if string.match(hex, "^%x%x%x%x%x%x$") then
			out[#out + 1] = string.upper(hex)
		end
	end
	return out
end

local function vecToStr(v)
	if typeof(v) == "Vector3" then
		return string.format("(%.4f,%.4f,%.4f)", v.X, v.Y, v.Z)
	end
	return tostring(v)
end

