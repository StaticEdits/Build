local function setTabVisual(active)
	exportTab.BackgroundColor3 = (active == "Export") and C.tabActive or C.tabInact
	exportTab.TextColor3       = (active == "Export") and C.text     or C.textMuted
	importTab.BackgroundColor3 = (active == "Import") and C.tabActive or C.tabInact
	importTab.TextColor3       = (active == "Import") and C.text     or C.textMuted
	debugTab.BackgroundColor3  = (active == "Debug")  and C.tabActive or C.tabInact
	debugTab.TextColor3        = (active == "Debug")  and C.text     or C.textMuted

	exportView.Visible      = (active == "Export")
	exportActionBar.Visible = (active == "Export")
	importView.Visible      = (active == "Import")
	debugView.Visible       = (active == "Debug")

	if active == "Debug" then refreshDebugView() end
end

function switchTab(tab)
	setTabVisual(tab)
end

