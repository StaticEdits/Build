local function getColorIndex(name)
	local lower = string.lower(name)
	local d = string.match(lower, "^color(%d+)$")
		or string.match(lower, "_color(%d+)$")
	return d and tonumber(d) or nil
end

local function getModelPalette(model)
	local byIndex = {}
	for _, obj in ipairs(model:GetDescendants()) do
		if obj:IsA("BasePart") then
			local i = getColorIndex(obj.Name)
			if i and not byIndex[i] then byIndex[i] = obj end
		end
	end
	local idx = {}
	for i in pairs(byIndex) do idx[#idx + 1] = i end
	table.sort(idx)
	local out = {}
	for _, i in ipairs(idx) do
		out[#out + 1] = colorToHex(byIndex[i].Color)
	end
	return out
end

local function getModelItemName(model)
	local item = model:FindFirstChild("Item", true)
	if item and item:IsA("StringValue") then
		return item.Value, item
	end
	local attr = model:GetAttribute("Item")
	if typeof(attr) == "string" then
		return attr, nil
	end
	return nil, nil
end

local function resolveFurnitureId(model)
	local name = getModelItemName(model)
	if not name then return nil end
	return furnitureIdCache[string.lower(name)]
end

local function isResizable(model)
	return model:GetAttribute("Min") ~= nil
		and model:GetAttribute("Max") ~= nil
end

-- Read the placement surface name (for diagnostic display only). This is
-- descriptive metadata: "Bottom" pieces have pivot at bbox bottom, "Back"
-- pieces are wall-mounted with pivot above bbox bottom, etc. It does NOT
-- change placement — the remote always anchors on the pivot.
local function getPlacementSurface(model)
	local v = model:GetAttribute("PlacementSurface")
	if typeof(v) == "string" and v ~= "" then return v end
	v = model:GetAttribute("Surface_Default")
	if typeof(v) == "string" and v ~= "" then return v end
	local id = resolveFurnitureId(model)
	if id then
		local tmpl = findTemplateModel(getTemplate(id))
		if tmpl then
			local tv = tmpl:GetAttribute("PlacementSurface")
			if typeof(tv) == "string" and tv ~= "" then return tv end
			tv = tmpl:GetAttribute("Surface_Default")
			if typeof(tv) == "string" and tv ~= "" then return tv end
		end
	end
	return "Bottom"
end

local function readModelPlacement(model)
	local pivot = model:GetPivot()
	local bbCF, bbSize = model:GetBoundingBox()
	local bottomY = bbCF.Position.Y - bbSize.Y / 2

	local currentSize = model:GetAttribute("CurrentSize")
	if typeof(currentSize) ~= "Vector3" then currentSize = nil end

	local offset = model:GetAttribute("OriginalOffset")
	if typeof(offset) ~= "CFrame" then offset = nil end

	return pivot, bottomY, currentSize, offset, bbSize
end

-- Diagnostic-only helper: show what a face-anchored export WOULD send, so
-- you can compare it to the pivot-verbatim value and confirm the remote is
-- pivot-based (the two differ by the local-face offset).
local function surfaceToLocalDir(surface)
	local s = string.lower(surface or "bottom")
	if s == "bottom" then return Vector3.new(0, -1, 0) end
	if s == "top"    then return Vector3.new(0,  1, 0) end
	if s == "front"  then return Vector3.new(0,  0, -1) end
	if s == "back"   then return Vector3.new(0,  0,  1) end
	if s == "left"   then return Vector3.new(-1, 0, 0) end
	if s == "right"  then return Vector3.new( 1, 0, 0) end
	return Vector3.new(0, -1, 0)
end

local function surfaceAnchor(pivot, bbSize, surface)
	local dir = surfaceToLocalDir(surface)
	local half = Vector3.new(bbSize.X * 0.5, bbSize.Y * 0.5, bbSize.Z * 0.5)
	local localFaceCenter = Vector3.new(
		dir.X * half.X,
		dir.Y * half.Y,
		dir.Z * half.Z
	)
	local faceWorld = pivot:PointToWorldSpace(localFaceCenter)
	return CFrame.new(faceWorld) * pivot.Rotation
end

