local function getPlayerName()
	return playerBox.Text ~= "" and playerBox.Text or LocalPlayer.Name
end

local function ownerMatches(owner, name)
	if not owner then return false end
	if owner:IsA("ObjectValue") then
		return owner.Value ~= nil
			and string.lower(owner.Value.Name) == string.lower(name)
	elseif owner:IsA("StringValue") then
		return string.lower(owner.Value) == string.lower(name)
	end
	local ok, v = pcall(function() return owner.Value end)
	return ok and tostring(v) == name
end

local function findHousePlot(name)
	local property = Workspace:FindFirstChild("Property")
	local plots = property and property:FindFirstChild("Plots")
	if not plots then warn("Property.Plots missing") return nil end

	for _, plot in ipairs(plots:GetChildren()) do
		local owners = {}
		local direct = plot:FindFirstChild("Owner")
		if direct then owners[#owners + 1] = direct end
		for _, d in ipairs(plot:GetDescendants()) do
			if d.Name == "Owner" and d ~= direct then
				owners[#owners + 1] = d
			end
		end
		for _, o in ipairs(owners) do
			if ownerMatches(o, name) then return o.Parent end
		end
	end
	return nil
end

local function findVehicle(folderName, name)
	local folder = Workspace:FindFirstChild(folderName)
	if not folder then warn("Workspace." .. folderName .. " missing") return nil end

	for _, v in ipairs(folder:GetChildren()) do
		local info = v:FindFirstChild("Info")
		local owner = info and info:FindFirstChild("Owner")
		local functional = v:FindFirstChild("Functional")
		local bounds = functional and functional:FindFirstChild("Bounds")
		if ownerMatches(owner, name) and bounds then return v end
	end
	return nil
end

local function getBuildTarget(name)
	if settings.buildTarget == "House" then
		local plot = findHousePlot(name)
		if not plot then return nil end
		local terrain = plot:FindFirstChild("Terrain", true)
		local grass = terrain and terrain:FindFirstChild("Grass", true)
		local active = plot:FindFirstChild("ActiveAssets", true)
		local furniture = active and active:FindFirstChild("Furniture", true)
		if not (grass and grass:IsA("BasePart")) then
			warn("House plot missing Terrain.Grass"); return nil
		end
		if not furniture then
			warn("House plot missing ActiveAssets.Furniture"); return nil
		end
		return {
			instance  = plot,
			reference = grass,
			furniture = furniture,
			kind      = "House",
		}
	end

	local folderMap = {Car = "Cars", Trailer = "Trailers", Boat = "Boats"}
	local folderName = folderMap[settings.buildTarget]
	if not folderName then warn("Unknown target") return nil end

	local vehicle = findVehicle(folderName, name)
	if not vehicle then return nil end

	local functional = vehicle:FindFirstChild("Functional")
	local bounds = functional and functional:FindFirstChild("Bounds")
	local models = functional and functional:FindFirstChild("Models")
	local chassis = vehicle:FindFirstChild("Chassis", true)
	local center = chassis and chassis:FindFirstChild("CenterPiece", true)

	if not bounds then warn(vehicle:GetFullName() .. " missing Bounds") return nil end
	if not models then warn(vehicle:GetFullName() .. " missing Models") return nil end
	if not (center and center:IsA("BasePart")) then
		warn(vehicle:GetFullName() .. " missing CenterPiece"); return nil
	end

	return {
		instance  = vehicle,
		reference = center,
		furniture = models,
		kind      = settings.buildTarget,
	}
end

