local function refreshTypeButtons()
	for name, btn in pairs(typeButtons) do
		if name == vehicleType then
			btn.BackgroundColor3 = vehicleColors[name]
			btn.TextColor3       = C.text
		else
			btn.BackgroundColor3 = C.tabInact
			btn.TextColor3       = C.textMuted
		end
	end
end

for _, name in ipairs(typeNames) do
	typeButtons[name].MouseButton1Click:Connect(function()
		vehicleType = name
		refreshTypeButtons()
	end)
end
