--------------------------------------------------
-- HELPERS
--------------------------------------------------
local function cfToString(cf)
	local c = {cf:GetComponents()}
	for i, v in ipairs(c) do c[i] = string.format("%.5f", v) end
	return table.concat(c, ",")
end

local function stringToCFrame(str)
	local nums = {}
	for v in string.gmatch(str, "[^,]+") do table.insert(nums, tonumber(v)) end
	return CFrame.new(
		nums[1],  nums[2],  nums[3],
		nums[4],  nums[5],  nums[6],
		nums[7],  nums[8],  nums[9],
		nums[10], nums[11], nums[12]
	)
end

local function sizeToString(size)
	return table.concat({size.X, size.Y, size.Z}, ",")
end

local function stringToSize(str)
	local nums = {}
	for v in string.gmatch(str, "[^,]+") do table.insert(nums, tonumber(v)) end
	return {X = nums[1], Y = nums[2], Z = nums[3], P = 10}
end

local function colorToHex(c)
	local r = math.clamp(math.floor(c.R * 255 + 0.5), 0, 255)
	local g = math.clamp(math.floor(c.G * 255 + 0.5), 0, 255)
	local b = math.clamp(math.floor(c.B * 255 + 0.5), 0, 255)
	return string.format("%02x%02x%02x", r, g, b)
end

local function round(n, step)
	return math.floor(n / step + 0.5) * step
end

-- Returns the vehicle instance from workspace based on vehicleType and owner name
local function getVehicle(playerName)
	local name   = (playerName ~= "" and playerName) or LocalPlayer.Name
	local folder = Workspace:FindFirstChild(vehicleType)
	if not folder then
		warn(vehicleType .. " folder not found in Workspace")
		return nil
	end
	for _, vehicle in ipairs(folder:GetChildren()) do
		local info  = vehicle:FindFirstChild("Info")
		local owner = info and info:FindFirstChild("Owner")
		if owner and owner.Value == name then
			return vehicle
		end
	end
	warn("No " .. vehicleType:sub(1, -2) .. " found for player: " .. name)
	return nil
end

-- Gets the CenterPiece BasePart used as the relative CFrame anchor
-- Cars and Trailers: vehicle.Chassis.CenterPiece
-- Boats:             vehicle.BoatHull.CenterPiece
local function getCenterPiece(vehicle)
	if vehicleType == "Boats" then
		local hull = vehicle:FindFirstChild("BoatHull")
		if not hull then warn("BoatHull not found on boat") return nil end
		return hull:FindFirstChild("CenterPiece")
	else
		-- Cars and Trailers
		local chassis = vehicle:FindFirstChild("Chassis")
		if not chassis then warn("Chassis not found on vehicle") return nil end
		return chassis:FindFirstChild("CenterPiece")
	end
end

local function getBlockKey(id, relCF, sizeX, sizeY, sizeZ, hex)
	local p = relCF.Position
	local _, _, _, r00, r01, r02, r10, r11, r12, r20, r21, r22 = relCF:GetComponents()
	return string.format(
		"%s|%.1f,%.1f,%.1f|%.1f,%.1f,%.1f|%s|%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f,%.2f",
		id,
		round(p.X, 0.1), round(p.Y, 0.1), round(p.Z, 0.1),
		round(sizeX, 0.1), round(sizeY, 0.1), round(sizeZ, 0.1),
		hex,
		round(r00, 0.01), round(r01, 0.01), round(r02, 0.01),
		round(r10, 0.01), round(r11, 0.01), round(r12, 0.01),
		round(r20, 0.01), round(r21, 0.01), round(r22, 0.01)
	)
end

-- Builds a map of already-placed blocks on the vehicle for dupe safety
local function getExistingMap(vehicle, centerPiece)
	local map            = {}
	local modelsFolder   = vehicle:FindFirstChild("Functional")
		and vehicle.Functional:FindFirstChild("Models")
	if not modelsFolder then return map end

	local baseCF = centerPiece.CFrame
	local count  = 0

	for _, model in ipairs(modelsFolder:GetChildren()) do
		local item  = model:FindFirstChild("Item")
		local color = model:FindFirstChild("Color")
		if not (item and color) then continue end

		local id = furnitureIdCache[string.lower(item.Value)]
		if not id then continue end

		for _, part in ipairs(model:GetDescendants()) do
			if part:IsA("BasePart") then
				local relCF = baseCF:ToObjectSpace(part.CFrame)
				local key   = getBlockKey(id, relCF, part.Size.X, part.Size.Y, part.Size.Z, colorToHex(part.Color))
				map[key]    = true
				count      += 1
				if count % 100 == 0 then task.wait() end
			end
		end
	end

	return map
end

