-- EXPORT
--------------------------------------------------
function exportBlueprint()
	local vehicle = getVehicle(playerBox.Text)
	if not vehicle then return end

	local centerPiece = getCenterPiece(vehicle)
	if not centerPiece then
		warn("CenterPiece not found on vehicle")
		return
	end

	local modelsFolder = vehicle:FindFirstChild("Functional")
		and vehicle.Functional:FindFirstChild("Models")
	if not modelsFolder then
		warn("Functional.Models not found on vehicle")
		return
	end

	local blocks = {}
	for _, model in ipairs(modelsFolder:GetChildren()) do
		local item  = model:FindFirstChild("Item")
		local color = model:FindFirstChild("Color")
		if item and color then
			local id = furnitureIdCache[string.lower(item.Value)]
			if not id then continue end

			for _, part in ipairs(model:GetDescendants()) do
				if part:IsA("BasePart") then
					local rel = centerPiece.CFrame:ToObjectSpace(part.CFrame)
					table.insert(blocks, table.concat({
						id,
						cfToString(rel),
						model.Color.Value,
						sizeToString(part.Size),
						colorToHex(part.Color)
					}, "|"))
				end
			end
		end
	end

	if #blocks == 0 then warn("No valid parts found on vehicle") return end

	totalPartsLabel.Text = "Total parts: " .. #blocks

	if not settings.biggerExporter then
		if #blocks > PARTS_PER_BOX then
			exportBoxes[1].Text     = ""
			exportWarnLabel.Visible = true
			warn("Over 700 parts (" .. #blocks .. ") — enable Bigger Exporter in Settings!")
			return
		end
		exportWarnLabel.Visible = false
		exportBoxes[1].Text     = table.concat(blocks, ";")
	else
		exportWarnLabel.Visible = false
		local idx = 1
		for i, box in ipairs(exportBoxes) do
			local chunk = {}
			for _ = 1, PARTS_PER_BOX do
				if idx > #blocks then break end
				table.insert(chunk, blocks[idx])
				idx += 1
			end
			box.Text             = table.concat(chunk, ";")
			exportLabels[i].Text = "Box " .. i .. " — " .. #chunk .. " parts"
		end
	end

	-- Cache on the vehicle for convenience
	local value     = vehicle:FindFirstChild("Blueprint") or Instance.new("StringValue")
	value.Name      = "Blueprint"
	value.Value     = table.concat(blocks, ";")
	value.Parent    = vehicle

	print(vehicleType:sub(1, -2) .. " blueprint exported! Total parts:", #blocks)
end

--------------------------------------------------
-- IMPORT (with pause / resume)
--------------------------------------------------
local function importBlueprint()
	if importRunning then return end

	local vehicle = getVehicle(playerBox.Text)
	if not vehicle then return end

	local centerPiece = getCenterPiece(vehicle)
	if not centerPiece then
		warn("CenterPiece not found on vehicle")
		return
	end

	local code = blueprintBox.Text
	if code == "" then warn("No blueprint code") return end

	importRunning = true
	importPaused  = false

	runBtn.Text             = "Running…"
	runBtn.BackgroundColor3 = C.card
	runBtn.TextColor3       = C.textMuted
	pauseBtn.Visible        = true
	pauseBtn.BackgroundColor3 = C.pause
	pauseBtn.Text           = "⏸  Pause"
	pauseBtn.TextColor3     = C.text
	progressLabel.TextColor3 = C.textMuted

	local existingMap = {}
	if settings.dupeSafety then
		progressLabel.Text = "Scanning existing blocks…"
		existingMap = getExistingMap(vehicle, centerPiece)
	end

	local blocks  = string.split(code, ";")
	local total   = #blocks
	local placed  = 0
	local skipped = 0

	for _, block in ipairs(blocks) do
		while importPaused do task.wait(0.1) end

		if block ~= "" then
			local data      = string.split(block, "|")
			local id        = data[1]
			local relCFrame = stringToCFrame(data[2])
			local color     = data[3]
			local partSize  = stringToSize(data[4])
			local hex       = data[5]

			if settings.dupeSafety then
				local key = getBlockKey(id, relCFrame, partSize.X, partSize.Y, partSize.Z, hex)
				if existingMap[key] then
					skipped += 1
					progressLabel.Text = "Building " .. placed .. " / " .. total .. "  |  Skipped " .. skipped
					continue
				end
				existingMap[key] = true
			end

			local finalRelCFrame = relCFrame * CFrame.new(0, -partSize.Y / 2, 0)
			local sizeArg = {
				X = partSize.X * 10,
				Y = partSize.Y * 10,
				Z = partSize.Z * 10,
				P = 10
			}

			local placingPlayerName = playerBox.Text ~= "" and playerBox.Text or LocalPlayer.Name
			local PlacingFromUser   = Players:FindFirstChild(placingPlayerName)

			local args = {{
				PurchaseForPlace = true,
				Id               = id,
				Vehicle          = vehicle,
				RelativeCFrame   = finalRelCFrame,
				Color            = color,
				Size             = sizeArg,
				CustomColors     = {hex},
				PlacingFromUser  = PlacingFromUser,
			}}

			pcall(function()
				PlaceFurnitureRemote:InvokeServer(unpack(args))
			end)

			placed += 1
			progressLabel.Text = "Building " .. placed .. " / " .. total .. "  |  Skipped " .. skipped
		end
	end

	-- Done
	importRunning           = false
	importPaused            = false
	progressLabel.Text      = "✔  Done!  Placed: " .. placed .. "   Skipped: " .. skipped
	progressLabel.TextColor3 = C.success
	runBtn.Text             = "▶  Run Blueprint"
	runBtn.BackgroundColor3 = C.accent
	runBtn.TextColor3       = C.text
	pauseBtn.Visible        = false
end

