local EXTRA_ROW_HEIGHT = 42
local EXTRA_PADDING_TOP = 45

local function rebuildExtraPanel()
	local count = #ExtraColors
	local panelHeight = EXTRA_PADDING_TOP + count * EXTRA_ROW_HEIGHT + (count > 0 and 8 or 0)
	ExtraPanel.Size = UDim2.new(0, 240, 0, panelHeight)
	for i, entry in ipairs(ExtraColors) do
		entry.frame.Position = UDim2.new(0, 10, 0, EXTRA_PADDING_TOP + (i - 1) * EXTRA_ROW_HEIGHT)
	end
end

local function syncExtraPanelPosition()
	local mainPos = Main.AbsolutePosition
	local mainSize = Main.AbsoluteSize
	ExtraPanel.Position = UDim2.fromOffset(mainPos.X, mainPos.Y + mainSize.Y + 6)
end

