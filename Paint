    if input.KeyCode == Enum.KeyCode.L then applyToSelection() end
    if input.KeyCode == Enum.KeyCode.Backspace then clearSelection() end
    if input.KeyCode == Enum.KeyCode.P then
        Enabled = not Enabled
        ToggleButton.Text = Enabled and "Enabled" or "Disabled"
        ToggleButton.BackgroundColor3 = Enabled and T.Green or T.Red
    end
end)

