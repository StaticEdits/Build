--// PICKER STATE
local pickerH = 0
local pickerS = 0
local pickerV = 1
local pickerCallback = nil
local draggingWheel = false
local draggingSlider = false
local suppressHexUpdate = false -- prevent feedback loop between wheel and hex box

local pickerIsDragging = false
local pickerGuiDragStart = nil
local pickerGuiStartPos = nil

PickerDrag.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		pickerIsDragging = true
		pickerGuiDragStart = input.Position
		pickerGuiStartPos = Picker.Position
	end
end)
PickerDrag.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		pickerIsDragging = false
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if pickerIsDragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - pickerGuiDragStart
		Picker.Position = UDim2.fromOffset(
			pickerGuiStartPos.X.Offset + delta.X,
			pickerGuiStartPos.Y.Offset + delta.Y
		)
	end
end)

local function color3ToHex(c)
	return string.format("%02X%02X%02X",
		math.floor(c.R * 255 + 0.5),
		math.floor(c.G * 255 + 0.5),
		math.floor(c.B * 255 + 0.5)
	)
end

local function updatePickerVisuals()
	-- Slider gradient: top = current hue at full sat, bottom = black
	local hueColor = Color3.fromHSV(pickerH, 1, 1)
	SliderGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, hueColor),
		ColorSequenceKeypoint.new(1, Color3.new(0, 0, 0)),
	})

	-- Wheel dot position: angle = hue, distance from center = saturation
	-- Position is in WheelFrame local space. Center = (WheelSize/2, WheelSize/2).
	local radius = WheelSize / 2
	local angle = pickerH * math.pi * 2
	local dotX = radius + pickerS * radius * math.cos(angle)
	local dotY = radius + pickerS * radius * math.sin(angle)
	-- AnchorPoint(0.5,0.5) so the dot is centered on the color position
	WheelDot.Position = UDim2.fromOffset(dotX, dotY)

	-- Value overlay on wheel: V=1 → fully transparent (no black), V=0 → fully opaque black
	ValOverlay.BackgroundTransparency = pickerV

	-- Slider thumb: V=1 at top (Y=0), V=0 at bottom (Y=SliderH)
	local thumbY = math.clamp((1 - pickerV) * SliderH, 0, SliderH)
	SliderThumb.Position = UDim2.fromOffset(0, thumbY)

	-- Preview and hex (don't update hex box if the user is typing into it)
	local col = Color3.fromHSV(pickerH, pickerS, pickerV)
	PreviewSwatch.BackgroundColor3 = col
	if not suppressHexUpdate then
		HexInput.Text = "#" .. color3ToHex(col)
	end
end

-- When user types a hex into the box, parse and update the wheel/slider
HexInput.FocusLost:Connect(function()
	suppressHexUpdate = false
	local raw = HexInput.Text:gsub("#", ""):gsub("%s", "")
	if #raw == 6 then
		local r = tonumber(raw:sub(1,2), 16)
		local g = tonumber(raw:sub(3,4), 16)
		local b = tonumber(raw:sub(5,6), 16)
		if r and g and b then
			pickerH, pickerS, pickerV = Color3.fromRGB(r, g, b):ToHSV()
			updatePickerVisuals()
		end
	end
end)

HexInput:GetPropertyChangedSignal("Text"):Connect(function()
	suppressHexUpdate = true
end)

local function openPicker(screenX, screenY, currentHex, callback)
	pickerCallback = callback
	local hex = currentHex:gsub("#", "")
	local r = (tonumber(hex:sub(1,2), 16) or 140) / 255
	local g = (tonumber(hex:sub(3,4), 16) or 165) / 255
	local b = (tonumber(hex:sub(5,6), 16) or 80)  / 255
	pickerH, pickerS, pickerV = Color3.new(r, g, b):ToHSV()

	local vp = Camera.ViewportSize
	local px = math.clamp(screenX + 8, 0, vp.X - PICKER_W - 4)
	local py = math.clamp(screenY, 0, vp.Y - PICKER_H - 4)
	Picker.Position = UDim2.fromOffset(px, py)

	suppressHexUpdate = false
	updatePickerVisuals()
	Picker.Visible = true
end

-- Start wheel drag when clicking anywhere inside WheelFrame
WheelFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		draggingWheel = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		draggingWheel = false
		draggingSlider = false
	end
end)

SliderFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		draggingSlider = true
	end
end)

RunService.RenderStepped:Connect(function()
	if not Picker.Visible then return end

	if draggingWheel then
		local mousePos = UserInputService:GetMouseLocation()
		-- AbsolutePosition is top-left of WheelFrame in screen space
		local ap = WheelFrame.AbsolutePosition
		local radius = WheelSize / 2
		-- Center of wheel in screen space
		local cx = ap.X + radius
		local cy = ap.Y + radius
		local dx = mousePos.X - cx
		local dy = mousePos.Y - cy
		local dist = math.sqrt(dx * dx + dy * dy)
		pickerH = (math.atan2(dy, dx) / (math.pi * 2)) % 1
		pickerS = math.clamp(dist / radius, 0, 1)
		suppressHexUpdate = false
		updatePickerVisuals()
	end

	if draggingSlider then
		local mousePos = UserInputService:GetMouseLocation()
		local ap = SliderFrame.AbsolutePosition
		-- Clamp mouse Y relative to slider top
		local relY = math.clamp(mousePos.Y - ap.Y, 0, SliderH)
		pickerV = 1 - (relY / SliderH)
		suppressHexUpdate = false
		updatePickerVisuals()
	end
end)

ConfirmBtn.MouseButton1Click:Connect(function()
	-- Accept whatever is in HexInput if it's valid, otherwise use wheel values
	local raw = HexInput.Text:gsub("#", ""):gsub("%s", "")
	local hex
	if #raw == 6 and tonumber(raw, 16) then
		hex = raw:upper()
	else
		hex = color3ToHex(Color3.fromHSV(pickerH, pickerS, pickerV))
	end
	if pickerCallback then
		pickerCallback(hex)
	end
	Picker.Visible = false
end)

