		local c = Color3.fromRGB(
			tonumber(entry.hex:sub(1,2), 16) or 255,
			tonumber(entry.hex:sub(3,4), 16) or 255,
			tonumber(entry.hex:sub(5,6), 16) or 255
		)
		swatch.BackgroundColor3 = c
		hexLabel.Text = "#" .. entry.hex:upper()
	end

	swatch.MouseButton1Click:Connect(function()
		local absPos = swatch.AbsolutePosition
		openPicker(absPos.X + 35, absPos.Y, entry.hex, function(hex)
			setExtraColor(hex)
		end)
	end)

	removeBtn.MouseButton1Click:Connect(function()
		local ei = table.find(ExtraColors, entry)
		if ei then table.remove(ExtraColors, ei) end
		row:Destroy()
		rebuildExtraPanel()
	end)

	rebuildExtraPanel()
end

AddExtraButton.MouseButton1Click:Connect(addExtraColor)

--// PLAYER NAME RESOLUTION
local function resolvePlayerName(input)
	if input == "" then return "" end
	local lower = input:lower()
	local exactAccount, exactDisplay, partialAccount, partialDisplay

	for _, player in ipairs(Players:GetPlayers()) do
		local accName  = player.Name
		local dispName = player.DisplayName
		local accLower  = accName:lower()
		local dispLower = dispName:lower()

		if accLower == lower then
			exactAccount = accName
			break
		elseif dispLower == lower and not exactDisplay then
			exactDisplay = accName
		elseif accLower:sub(1, #lower) == lower and not partialAccount then
			partialAccount = accName
		elseif dispLower:sub(1, #lower) == lower and not partialDisplay then
			partialDisplay = accName
		end
	end

	return exactAccount or exactDisplay or partialAccount or partialDisplay or input
end

PlayerBox.FocusLost:Connect(function(enterPressed)
	if enterPressed then
		PlayerBox.Text = resolvePlayerName(PlayerBox.Text)
	end
end)

--// PLOT LOOKUP (original — for server invoke)
local function getPlot(name)
	local playerName = (name ~= "" and name) or LocalPlayer.Name
	for _, plot in ipairs(Workspace.Property.Plots:GetChildren()) do
		for _, obj in ipairs(plot:GetDescendants()) do
			if obj.Name == "Owner" then
				if obj:IsA("ObjectValue") and obj.Value and obj.Value.Name == playerName then
					return obj.Parent
				elseif obj:IsA("StringValue") and obj.Value == playerName then
					return obj.Parent
				end
			end
		end
	end
end

-- For ownership checking — always returns the top-level Plots child
local function getPlotRoot(name)
	local playerName = (name ~= "" and name) or LocalPlayer.Name
	for _, plot in ipairs(Workspace.Property.Plots:GetChildren()) do
		for _, obj in ipairs(plot:GetDescendants()) do
			if obj.Name == "Owner" then
				if obj:IsA("ObjectValue") and obj.Value and obj.Value.Name == playerName then
					return plot
				elseif obj:IsA("StringValue") and obj.Value == playerName then
					return plot
				end
			end
		end
	end
end

--// SELECTION

local function clearSelection()
	for _, highlight in pairs(HighlightMap) do
		if highlight then highlight:Destroy() end
	end
	table.clear(SelectedModels)
	table.clear(HighlightMap)
end

local function addHighlight(model)
	if HighlightMap[model] then return end
	local highlight = Instance.new("Highlight")
	highlight.FillColor = Color3.fromRGB(0, 170, 255)
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = model
	HighlightMap[model] = highlight
end

local function removeHighlight(model)
	if HighlightMap[model] then
		HighlightMap[model]:Destroy()
		HighlightMap[model] = nil
	end
end

local function getFurnitureModel(part)
	local current = part
	while current and current ~= Workspace do
		if current:IsA("Model") and current:GetAttribute("SerialId") then
			return current
		end
		current = current.Parent
	end
	return nil
end

local function isOwnedByTarget(model)
	local targetName = PlayerBox.Text ~= "" and PlayerBox.Text or LocalPlayer.Name
	local plotRoot = getPlotRoot(targetName)
	if not plotRoot then
		warn("FurniturePainter: no plot found for '" .. targetName .. "'")
		return false
	end
	return model:IsDescendantOf(plotRoot)
end

local function toggleSelection(model)
	if not model then return end
	local index = table.find(SelectedModels, model)
	if index then
		table.remove(SelectedModels, index)
		removeHighlight(model)
	else
		table.insert(SelectedModels, model)
		addHighlight(model)
	end
end

local function getFurnitureId(serialRaw)
	if typeof(serialRaw) == "string" then
		local split = string.split(serialRaw, "_")
		return tonumber(split[#split])
	end
	return tonumber(serialRaw)
end

--// BUILD COLOR TABLE

local function buildColorTable()
	local colors = {}
	table.insert(colors, primaryHex)
	for _, entry in ipairs(ExtraColors) do
		if entry.hex ~= "" then
			table.insert(colors, entry.hex)
		end
	end
	return colors
end

local function applyColor(model)
	local serialRaw = model:GetAttribute("SerialId")
	if not serialRaw then return end
	local serialId = getFurnitureId(serialRaw)
	if not serialId then return end

	local plot = getPlot(PlayerBox.Text)
	if not plot then warn("Plot not found") return end

	local colors = buildColorTable()
	local materialId = tonumber(MaterialBox.Text) or 16

	pcall(function()
		ChangeColor:InvokeServer(serialId, plot, colors)
	end)
	pcall(function()
		ChangeTexture:InvokeServer(serialId, plot, 1, materialId)
	end)
end

local function applyToSelection()
	for _, model in ipairs(SelectedModels) do
		applyColor(model)
	end
	clearSelection()
end

