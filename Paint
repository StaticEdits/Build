--// GUI DRAGGING

local isDraggingGui = false
local guiDragStart = nil
local guiStartPos = nil

DragHandle.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isDraggingGui = true
		guiDragStart = input.Position
		guiStartPos = Main.Position
	end
end)
DragHandle.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		isDraggingGui = false
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if isDraggingGui and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - guiDragStart
		Main.Position = UDim2.new(
			guiStartPos.X.Scale, guiStartPos.X.Offset + delta.X,
			guiStartPos.Y.Scale, guiStartPos.Y.Offset + delta.Y
		)
	end
end)

--// CLICK SELECT

Mouse.Button1Down:Connect(function() end)

Mouse.Button1Up:Connect(function()
	if not Enabled then return end
	if Picker.Visible then return end -- don't accidentally deselect while using picker

	local ctrl =
		UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)

	local target = Mouse.Target
	if not target then return end

	local model = getFurnitureModel(target)

	if ctrl then
		if model and isOwnedByTarget(model) then
			toggleSelection(model)
		end
	else
		clearSelection()
		if model and isOwnedByTarget(model) then
			toggleSelection(model)
		end
	end
end)

