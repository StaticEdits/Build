WheelCanvas.BorderSizePixel = 0
WheelCanvas.ZIndex = 52
WheelCanvas.Parent = WheelFrame

--// BUILD COLOR WHEEL FROM POLAR SEGMENTS
local wheelPixels = {}
local cx = WheelSize / 2
local cy = WheelSize / 2
local RINGS = 12

for ring = 1, RINGS do
    local innerR = (ring - 1) / RINGS * (WheelSize / 2)
    local outerR = ring / RINGS * (WheelSize / 2)
    local midR   = (innerR + outerR) / 2
    local sat    = midR / (WheelSize / 2)
    local segs   = math.max(8, math.floor(2 * math.pi * midR / 5))
    local segSize = math.ceil(outerR - innerR) + 2

    for seg = 0, segs - 1 do
        local angle = (seg / segs) * math.pi * 2
        local hue   = (angle / (math.pi * 2)) % 1
        local midAngle = angle + (math.pi / segs)
        local px = cx + midR * math.cos(midAngle)
        local py = cy + midR * math.sin(midAngle)

        local f = Instance.new("Frame")
        f.Size = UDim2.fromOffset(segSize, segSize)
        f.Position = UDim2.fromOffset(px - segSize / 2, py - segSize / 2)
        f.BackgroundColor3 = Color3.fromHSV(hue, sat, 1)
        f.BorderSizePixel = 0
        f.ZIndex = 52
        f:SetAttribute("H", hue)
        f:SetAttribute("S", sat)
        f.Parent = WheelCanvas
        table.insert(wheelPixels, f)
    end
end

local function drawWheel(brightness)
    for _, f in ipairs(wheelPixels) do
        f.BackgroundColor3 = Color3.fromHSV(
            f:GetAttribute("H"),
            f:GetAttribute("S"),
            brightness
        )
    end
end

